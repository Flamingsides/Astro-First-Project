---
import BaseLayout from "../layout/BaseLayout.astro";

const title = "Astro";
const names = ["Suhaib", "Ahmed", "Andrew"];

import data from "../data/sample.json";

const edata = await fetch("https://jsonplaceholder.typicode.com/todos/1");
const edata_json = await edata.json();
---

<BaseLayout>
    <h1>Astro</h1>
    {data.map((p) => (
        <p>{p.name}</p>
        <p>{p.age}</p>
        <p>{p.occupation}</p>
    ))}

    <br />

    {JSON.stringify(edata_json)}
</BaseLayout>
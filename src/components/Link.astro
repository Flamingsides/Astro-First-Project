---
const { href } = Astro.props;
---

<a href={href}>
  <slot />
</a>

<!-- Style tags are scoped per component, unless marked with is:global -->
<style>
  a {
    display: block;
    border: solid 2px black;
    background: #000;
    color: white;
    border-radius: 2px;
    padding: 5px;
    text-decoration: none;
  }

  a:hover {
    background-color: darkgray;
    color: black;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
  }
</style>
